# --- Postgres (dev) ---
DATABASE_URL=postgres://twilio_chat:devpassword@localhost:5433/twilio_chat

# --- Server ---
PORT=3001
WEB_ORIGIN=http://localhost:5173

# 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET_KEY=
SESSION_SECRET=

# --- Claude Agent SDK via Amazon Bedrock ---
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-opus-4-7
# Use either static keys OR AWS_PROFILE OR an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# AWS_BEARER_TOKEN_BEDROCK=
