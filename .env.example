# --- Postgres (dev) ---
DATABASE_URL=postgres://twilio_chat:devpassword@localhost:5433/twilio_chat

# --- Server ---
PORT=3001
WEB_ORIGIN=http://localhost:5173

# 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET_KEY=
SESSION_SECRET=

# ===========================================================================
# Claude provider — pick ONE of the two blocks below.
# The Agent SDK auto-detects: if CLAUDE_CODE_USE_BEDROCK=1 is set,
# Bedrock wins; otherwise ANTHROPIC_API_KEY is used.
# ===========================================================================

# --- Option A: Direct Anthropic API ---
# Get a key at https://console.anthropic.com/. Billing via Anthropic.
ANTHROPIC_API_KEY=

# --- Option B: Amazon Bedrock ---
# Use this if your organization routes LLM traffic through AWS.
# Requires model access granted to Claude Opus 4.7 in your chosen region.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-opus-4-7
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# AWS_BEARER_TOKEN_BEDROCK=
